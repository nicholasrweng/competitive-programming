
n = int(input())
segments = []
for i in range(n):
    x,y = map(int, input().split())
    segments.append((x-y, x+y))



segments.sort(key = lambda x: (x[0], -x[1]))
answer = 0
max_right = -1

for left, right in segments:
    if right > max_right:
        answer += 1
        max_right = right

print(answer)
