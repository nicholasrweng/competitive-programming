
from collections import deque

n = int(input())

global n

cows = []
for i in range(n):
    x,y,p = map(int, input().split())
    cows.append((x,y,p))

adj = [[] for i in range(n)]

for i in range(n):
    for j in range(i+1, n):
        x1,y1,p1 = cows[i]
        x2,y2,p2 = cows[j]

       if (x1-x2)**2 + (y1-y2)**2 <= p1**2:
           adj[i].append(j)
        
        if (x1-x2)**2 + (y1-y2)**2 <= p2**2:
            adj[j].append(i)

def bfs(start):
    visited = [False for i in range(n)]
    visted[start] = True
    q = deque([start])
    count = 0
    
    while q:
        node = q.popleft()
        count += 1

        for v in adj[node]:
            if not visited[v]:
                q.append(v)
                visited[v] = True

    return count

max_ = float("-inf")

for i in range(n):
    max_ = max(max_, bfs(i))
        
        

