import heapq

heap = []
n, g = map(int, input().split())

log = []

for i in range(n):
    d, c_id, diff = map(int, input().split())
    log.append((d, c_id, diff))

log.sort(key=lambda x: x[0])

milks = {}
cows = {}

milks[g] = float('inf')
times_changed = 0
cur_max = g
heapq.heappush(heap, -g)

for d, c_id, diff in log:
    old = cows.get(c_id, g)
    new = old + diff
    cows[c_id] = new

    milks[old] = milks[old] - 1
    milks[new] = milks.get(new, 0) + 1

    if old < cur_max:
        if new == cur_max:
            times_changed += 1

        elif new > cur_max:
            cur_max = new
            times_changed += 1
            heapq.heappush(heap, -new)

        else:
            if milks[new] == 1:
                heapq.heappush(heap, -new)

    elif old == cur_max:
        if milks[old] == 0:
            if new > cur_max:
                cur_max = new
                heapq.heappush(heap, -new)

            elif new < cur_max:
                if milks[new] == 1:
                    heapq.heappush(heap, -new)

                while heap and milks.get(-heap[0], 0) == 0:
                    heapq.heappop(heap)

                cur_max = -heap[0]

                if cur_max == new:
                    if milks.get(new, 0) >= 2:
                        times_changed += 1
                else:
                    times_changed += 1

        elif milks[old] != 0:
            times_changed += 1

            if new > cur_max:
                cur_max = new

            if milks[new] == 1:
                heapq.heappush(heap, -new)

print(times_changed)