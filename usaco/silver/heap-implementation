class Heap:
    def __init__(self):
        self.heap = []
    
    def insert(self, value):
        self.heap.append(value)
        pointer = len(self.heap) - 1
        while pointer > 0:
            parent = (pointer + 1)//2 - 1
            if self.heap[parent] < self.heap[pointer]:
                self.heap[parent], self.heap[pointer] = self.heap[pointer], self.heap[parent]
                pointer = parent
            else:
                break
    
