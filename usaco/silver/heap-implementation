def heapify(arr):
    heap = Heap()
    heap.heap = arr
    for i in range(len(arr)-1, -1, -1):
        pointer = i
        left_child = 2*(pointer+1)-1
        right_child = 2*(pointer+1)-1+1
        
        
        while True:
            if left_child >= len(arr):
                break

            swap = left_child

            if right_child < len(arr):
                if heap.heap[right_child] > heap.heap[swap]:
                    swap = right_child

            if heap.heap[pointer] >= heap.heap(swap):
