n = int(input())
high_cards = []
low_cards = []
for i in range(n//2):
    high_cards.append(int(input()))

for i in range(n//2):
    low_cards.append(int(input()))

all_cards = high_cards + low_cards
all_cards.sort()

counter = 0
bessie_cards = []
for i in range(1,2*n+1):
    if counter < len(all_cards) and i == all_cards[counter]:
        counter += 1
    else:
        bessie_cards.append(i)

bessie_cards.sort()
bessie_low_cards = bessie_cards[:n//2]
bessie_high_cards = bessie_cards[n//2:]

bessie_low_cards.sort()
bessie_high_cards.sort(reverse = True)

high_cards.sort(reverse=True)
low_cards.sort()

points = 0

lpointer = 0
rpointer = len(bessie_high_cards)-1
for i in range(n//2):
    if high_cards[i] < bessie_high_cards[lpointer]:
        points += 1
        lpointer += 1
    else:
        rpointer -= 1

lpointer = 0
rpointer = len(bessie_low_cards)-1
for i in range(n//2):
    if low_cards[i] > bessie_low_cards[lpointer]:
        points += 1
        lpointer += 1
    else:
        rpointer -= 1

print(points)