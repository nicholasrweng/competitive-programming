n = int(input())
min_x = 10**9
min_y = 10**9
max_x = 0
max_y = 0
cows = []

for i in range(n):
    x,y = map(int, input().split())
    cows.append((x,y))
    max_x = max(max_x, x)
    max_y = max(max_y, y)
    min_x = min(min_x, x)
    min_y = min(min_y, y)


ans_so_far = 10**18

answer_1 = (max_x - min_x) * (max_y - min_y)

cows.sort(key = lambda x: (x[0], x[1]))
highest_from_left = [0 for i in range(n)]
highest_from_left[0] = cows[0][1]
for i in range(1, n):
    highest_from_left[i] = max(highest_from_left[i-1], cows[i][1])

highest_from_right = [0 for i in range(n)]
highest_from_right[n-1] = cows[n-1][1]
for i in range(n-2, -1, -1):
    highest_from_right[i] = max(highest_from_right[i+1], cows[i][1])

lowest_from_left = [0 for i in range(n)]
lowest_from_left[0] = cows[0][1]
for i in range(1, n):
    lowest_from_left[i] = min(lowest_from_left[i-1], cows[i][1])

lowest_from_right = [0 for i in range(n)]
lowest_from_right[n-1] = cows[n-1][1]
for i in range(n-2, -1, -1):
    lowest_from_right[i] = min(lowest_from_right[i+1], cows[i][1])

for i in range(n):
    if i < n-1 and cows[i][0] != cows[i+1][0]:
        left_area = (cows[i][0] - min_x) * (highest_from_left[i] - lowest_from_left[i])
        right_area = (max_x - cows[i+1][0]) * (highest_from_right[i+1] - lowest_from_right[i+1])
        ans_so_far = min(ans_so_far, left_area + right_area)


swapped_cows = [(y,x) for x,y in cows]
swapped_cows.sort(key = lambda x: (x[0], x[1]))
highest_from_left = [0 for i in range(n)]
highest_from_left[0] = swapped_cows[0][1]
for i in range(1, n):
    highest_from_left[i] = max(highest_from_left[i-1], swapped_cows[i][1])

highest_from_right = [0 for i in range(n)]
highest_from_right[n-1] = swapped_cows[n-1][1]
for i in range(n-2, -1, -1):
    highest_from_right[i] = max(highest_from_right[i+1], swapped_cows[i][1])

lowest_from_left = [0 for i in range(n)]
lowest_from_left[0] = swapped_cows[0][1]
for i in range(1, n):
    lowest_from_left[i] = min(lowest_from_left[i-1], swapped_cows[i][1])

lowest_from_right = [0 for i in range(n)]
lowest_from_right[n-1] = swapped_cows[n-1][1]
for i in range(n-2, -1, -1):
    lowest_from_right[i] = min(lowest_from_right[i+1], swapped_cows[i][1])

for i in range(n):
    if i < n-1 and swapped_cows[i][0] != swapped_cows[i+1][0]:
        left_area = (swapped_cows[i][0] - min_y) * (highest_from_left[i] - lowest_from_left[i])
        right_area = (max_y - swapped_cows[i+1][0]) * (highest_from_right[i+1] - lowest_from_right[i+1])
        ans_so_far = min(ans_so_far, left_area + right_area)

print(answer_1 - ans_so_far)





