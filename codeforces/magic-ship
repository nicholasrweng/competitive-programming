x1,y1 = list(map(int, input().split()))
x2, y2 = list(map(int, input().split()))
n = int(input())
directions = list(map(str, input().split()))

d_map = {
    'U': (0,1),
    'D': (0,-1),
    'L': (-1,0),
    'R': (1,0)
}

x,y = [0,0]

net_dirs = [(0,0)]
for d in directions:
    dx, dy = d_map[d]
    x += dx
    y += dy
    net_dirs.append((x,y))

net_dist = (x2-x1, y2-y1)
works = False
for i in range(1, n):
    xt, yt = net_dist
    xd, yd = net_dirs[i]
    if abs(xt-xd) + abs(yt-yd) <= i:
        works = True
        print(i)
        break

if not works:
    print(-1)
    
